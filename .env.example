HOST=127.0.0.1
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
API_PUBLISHED_PORT=3000
WEB_PUBLISHED_PORT=8080

# Optional LLM providers. Supply all three values for each enabled provider.
GROQ_API_KEY=
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_SMALL_MODEL=gemini-3.5-flash-lite
GEMINI_STRONG_MODEL=gemini-3.5-flash

# Search provider keys and local quota limits. Check provider dashboards before use.


FETCH_BROWSER_ENABLED=false

RETRIEVAL_EMBEDDING_DIR=.data/models/embedding
SEMANTIC_SEARCH_CACHE_ENABLED=true
RETRIEVAL_EMBEDDING_REVISION=751bff37182d3f1213fa05d7196b954e230abad9
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_DIR=.data/models/reranker

CHAT_DB_PATH=.data/chat.sqlite
CHAT_SECURE_COOKIE=false
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
# Set CHAT_ALLOWED_ORIGINS to a comma-separated list for non-default browser origins.

TRACE_DB_PATH=.data/traces.sqlite
# Optional market data for timestamped stock quotes and charts.
TWELVE_DATA_API_KEY=

TRACE_REPLAY_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
